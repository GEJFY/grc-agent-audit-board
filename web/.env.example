# RAG質問応答APIを本番動作させる場合に設定(未設定ならデモ応答になる)
# Azure Static Web Apps では、この値をリソースの
# 「設定 > 環境変数(Application settings)」に登録する。
ANTHROPIC_API_KEY=

# --- batch/ (EDINET収集バッチ) 用。Webサイトの表示だけなら不要 ---
# EDINET API v2 の Subscription-Key(APIキー)。取得方法は README を参照。
EDINET_API_KEY=
# Supabase(収集データの保存先)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
